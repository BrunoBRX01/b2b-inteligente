# Configuração para uso SOMENTE no próprio computador.
HOST=127.0.0.1
PORT=3000
COOKIE_TRANSPORT=http-local
# Opcional: restringe e-mails cadastráveis (exemplo: empresa.com.br).
ALLOWED_EMAIL_DOMAINS=
# Sem chave externa: o chatbot público mantém respostas institucionais locais.

# IA local (Ollama). Instale o Ollama e rode: ollama pull qwen2.5:7b
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b
# on = a IA executa tarefas sozinha (atrasos, cotações, resumo diário)
AI_AUTOPILOT=on
